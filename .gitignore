# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local microsurgery backups
.surgery-backups/
.microsurgery-backups/
*.before-*
*.backup
*.working-*
.source-data/

# packaged paid bundles — never served, never committed
/dist

# Sports first-party network — local development only.
# Production writes these to Postgres. A developer's local credential hashes
# and test submissions must never be committed.
data/sports/submissions.json
data/sports/credentials.json
