# Open Mirror hub — environment variable names only. Real values live in
# .env.local (git-ignored) and in Vercel project settings. Never commit one.

# ── Device request form (Build Machine service) ─────────────────────────────
# All three are required for server-side delivery; until they exist the form
# falls back to composing an email in the customer's own mail app.
RESEND_API_KEY=
DEVICE_REQUEST_NOTIFY_EMAIL=
DEVICE_REQUEST_FROM_EMAIL=
# Optional kill switch: set to 0 to disable online submission.
DEVICE_REQUEST_FORM_ENABLED=

# ── Existing hub features ────────────────────────────────────────────────────
OPENAI_API_KEY=
YVP_APP_KEY=

# ── Sports Desk (all optional) ───────────────────────────────────────────────
# The desk works with none of these: extraction, calculations, the Story
# Finder, and the writing are all deterministic TypeScript.
# Name a model to let it REWRITE the prose — never the facts. Any OpenAI-shaped
# endpoint works, including a local Ollama (http://localhost:11434/v1).
SPORTS_DESK_MODEL=
SPORTS_DESK_MODEL_BASE_URL=
SPORTS_DESK_MODEL_API_KEY=
# The team this desk covers. Defaults live in src/lib/sports/team.ts.
SPORTS_DESK_TEAM_NAME=
SPORTS_DESK_TEAM_MASCOT=
SPORTS_DESK_TEAM_ALIASES=
SPORTS_DESK_TEAM_LEVEL=
