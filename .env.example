# Open Mirror hub — environment variable names only. Real values live in
# .env.local (git-ignored) and in Vercel project settings. Never commit one.

# ── Device request form (Build Machine service) ─────────────────────────────
# All three are required for server-side delivery; until they exist the form
# falls back to composing an email in the customer's own mail app.
RESEND_API_KEY=
DEVICE_REQUEST_NOTIFY_EMAIL=
DEVICE_REQUEST_FROM_EMAIL=
# Optional kill switch: set to 0 to disable online submission.
DEVICE_REQUEST_FORM_ENABLED=

# ── Partnership inquiries (/partnership) ────────────────────────────────────
# Online sending needs RESEND_API_KEY (above) plus ONE sender address on a
# domain verified in Resend, e.g. "Open Mirror <hello@openmirrorllc.com>".
# Falls back to DEVICE_REQUEST_FROM_EMAIL. Until one exists, the page works
# and hands answers to the visitor's own email app — it never claims a code
# was sent.
PARTNERSHIP_FROM_EMAIL=
# Optional. Owner inbox; defaults to DEVICE_REQUEST_NOTIFY_EMAIL, then the
# public contact address. Server-only — never rendered.
PARTNERSHIP_NOTIFY_EMAIL=
# Optional. Signing key for codes; derived from RESEND_API_KEY when unset.
PARTNERSHIP_TOKEN_SECRET=
# Optional kill switch: set to 0 to turn online sending off.
PARTNERSHIP_FORM_ENABLED=

# ── Existing hub features ────────────────────────────────────────────────────
OPENAI_API_KEY=
YVP_APP_KEY=

# ── Sports Desk (all optional) ───────────────────────────────────────────────
# The desk works with none of these: extraction, calculations, the Story
# Finder, and the writing are all deterministic TypeScript.
# Name a model to let it REWRITE the prose — never the facts. Any OpenAI-shaped
# endpoint works, including a local Ollama (http://localhost:11434/v1).
SPORTS_DESK_MODEL=
SPORTS_DESK_MODEL_BASE_URL=
SPORTS_DESK_MODEL_API_KEY=
# The team this desk covers. Defaults live in src/lib/sports/team.ts.
SPORTS_DESK_TEAM_NAME=
SPORTS_DESK_TEAM_MASCOT=
SPORTS_DESK_TEAM_ALIASES=
SPORTS_DESK_TEAM_LEVEL=

# ── Sports: first-party results network ──────────────────────────────────────
# Durable production writes for school-submitted scores. Without this the site
# falls back to local files, which a serverless deployment cannot write — the
# reporting pages then say so up front instead of losing a coach's report.
# Any Postgres works; the rest of this estate uses Neon's free tier.
# Set it in Vercel project settings, never in the repo.
DATABASE_URL=
# Optional: point sports at a different database than the rest of the app.
SPORTS_DATABASE_URL=
