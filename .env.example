# Open Mirror hub — environment variable names only. Real values live in
# .env.local (git-ignored) and in Vercel project settings. Never commit one.

# ── Device request form (Build Machine service) ─────────────────────────────
# All three are required for server-side delivery; until they exist the form
# falls back to composing an email in the customer's own mail app.
RESEND_API_KEY=
DEVICE_REQUEST_NOTIFY_EMAIL=
DEVICE_REQUEST_FROM_EMAIL=
# Optional kill switch: set to 0 to disable online submission.
DEVICE_REQUEST_FORM_ENABLED=

# ── Existing hub features ────────────────────────────────────────────────────
OPENAI_API_KEY=
YVP_APP_KEY=
